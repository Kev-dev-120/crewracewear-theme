{% doc %}
  @prompt
    Add a tri-tone gradient background (gray, red, and black) to the Category tiles section. The gradient should blend all three colors smoothly and apply as the background of the section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gradient-background-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.min_height }}px;
    background: linear-gradient(
      {{ block.settings.gradient_angle }}deg,
      {{ block.settings.color_1 }} 0%,
      {{ block.settings.color_2 }} 50%,
      {{ block.settings.color_3 }} 100%
    );
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-gradient-background__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-gradient-background-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-gradient-background-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gradient-background__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 style="color: {{ block.settings.heading_color }}; font-size: {{ block.settings.heading_size }}px; margin: 0 0 {{ block.settings.heading_spacing }}px 0; text-align: {{ block.settings.text_align }};">
        {{ block.settings.heading }}
      </h2>
    {% endif %}
    
    {% if block.settings.text != blank %}
      <div style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; text-align: {{ block.settings.text_align }};">
        {{ block.settings.text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Gradient background",
  "settings": [
    {
      "type": "header",
      "content": "Gradient colors"
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "First color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Second color",
      "default": "#dc2626"
    },
    {
      "type": "color",
      "id": "color_3",
      "label": "Third color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 135
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 100,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height mobile",
      "min": 100,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Horizontal padding mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Gradient background"
    }
  ]
}
{% endschema %}
