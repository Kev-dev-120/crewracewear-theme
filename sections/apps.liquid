{%- if section.blocks.size > 0 -%}
  <section class="apps-section" id="{{ section.settings.anchor_id | default: section.id | handleize }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="apps-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- render block -%}
    {%- endfor -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other pages link straight to this section, e.g. /products/example#reviews"
    }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Apps" }
  ]
}
{% endschema %}
