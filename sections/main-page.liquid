<section class="page{% if page.content == blank %} page--title-only{% endif %}">
  <div class="page__header">
    <h1>{{ page.title }}</h1>
  </div>
  {%- if page.content != blank -%}
    <div class="page__content rte">
      {{ page.content }}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
