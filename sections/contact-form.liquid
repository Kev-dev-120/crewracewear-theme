<section class="contact-form-section">
  <div class="contact-form-section__inner">
    <h1>{{ section.settings.heading | default: 'Contact Us' }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="contact-form-section__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="contact-form-section__success">Thanks — we'll get back to you soon.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="contact-form-section__errors">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-form-section__row">
        <div class="contact-form-section__field">
          <label for="ContactFormName">Name</label>
          <input type="text" id="ContactFormName" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
        </div>
        <div class="contact-form-section__field">
          <label for="ContactFormEmail">Email</label>
          <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>

      <div class="contact-form-section__field">
        <label for="ContactFormSubject">Subject</label>
        <input type="text" id="ContactFormSubject" name="contact[subject]" value="{{ form.subject }}">
      </div>

      <div class="contact-form-section__field">
        <label for="ContactFormMessage">Message</label>
        <textarea id="ContactFormMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>

      <button type="submit" class="btn btn--primary">Send Message</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about an order, a collab, or just want to say hey? Send it our way." }
  ],
  "presets": [
    { "name": "Contact form" }
  ]
}
{% endschema %}
