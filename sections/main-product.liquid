<section class="product">
  <div class="product__media">
    {%- if product.media.size > 0 -%}
      <div class="product__slideshow">
        <button class="product__arrow product__arrow--prev" onclick="slideProduct(-1)">&#8592;</button>
        <div class="product__slides">
          {%- for media in product.media -%}
             <img class="product__slide{% if forloop.first %} active{% endif %}" src="{{ media | image_url: width: 1400 }}" alt="{{ media.alt | escape }}" width="1400" height="{{ 1400 | divided_by: media.aspect_ratio }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {%- endfor -%}
        </div>
        <button class="product__arrow product__arrow--next" onclick="slideProduct(1)">&#8594;</button>
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if product.vendor != blank -%}<p class="product__vendor">{{ product.vendor }}</p>{%- endif -%}
    <h1 class="product__title">{{ product.title }}</h1>
    <div class="product__price" data-product-price>
      {%- if product.compare_at_price > product.price -%}
        <span class="product__price--sale">{{ product.price | money }}</span>
        <span class="product__price--compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    {%- assign handle_suffix = product.handle | slice: -5, 5 -%}
    {%- if handle_suffix == '-plus' -%}
      {%- assign companion_handle = product.handle | remove: '-plus' -%}
      {%- assign companion = all_products[companion_handle] -%}
      {%- if companion != blank -%}
        <a href="{{ companion.url }}" class="product__size-crosslink">Need XS&ndash;L? Shop standard sizes &rarr;</a>
      {%- endif -%}
    {%- else -%}
      {%- assign companion_handle = product.handle | append: '-plus' -%}
      {%- assign companion = all_products[companion_handle] -%}
      {%- if companion != blank -%}
        <a href="{{ companion.url }}" class="product__size-crosslink">Need XL or larger? Shop Plus Sizes &rarr;</a>
      {%- endif -%}
    {%- endif -%}

    {% form 'product', product, id: 'product-form' %}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="product__option">
            <label>{{ option.name }}</label>
            <div class="product__option-values">
              {%- for value in option.values -%}
                <input type="radio" id="option-{{ option.position }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}" data-option-index="{{ option.position | minus: 1 }}" {% if option.selected_value == value %}checked{% endif %}>
                <label for="option-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <select name="id" class="product__variant-select" data-product-variant-select style="display:none">
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
            {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
          </option>
        {%- endfor -%}
      </select>

      <button type="submit" class="btn btn--primary btn--full" data-add-to-cart {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        <span data-add-to-cart-label>
          {%- if product.selected_or_first_available_variant.available -%}ADD TO CART{%- else -%}SOLD OUT{%- endif -%}
        </span>
      </button>
    {% endform %}

    <div class="product__description rte">{{ product.description }}</div>
  </div>
</section>
  <style>
    .product__slideshow { position: relative; }
    .product__slide {
      display: none;
      width: 100%;
      height: auto;
      background: var(--color-off-white);
      border-radius: var(--radius);
    }
    .product__slide.active { display: block; }
    .product__arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: #111; color: #fff; border: none; padding: 12px 16px;
      font-size: 20px; cursor: pointer; z-index: 2;
    }
    .product__arrow--prev { left: 0; }
    .product__arrow--next { right: 0; }
    .product__size-crosslink {
      display: inline-block;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: underline;
      color: var(--color-black);
    }
  </style>
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.product__slide');
    function slideProduct(dir) {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + dir + slides.length) % slides.length;
      slides[currentSlide].classList.add('active');
    }
  </script>
  <script>
    (function () {
      var productVariants = {{ product.variants | json }};
      var form = document.getElementById('product-form');
      if (!form) return;

      var variantSelect = form.querySelector('[data-product-variant-select]');
      var priceEl = document.querySelector('[data-product-price]');
      var addBtn = form.querySelector('[data-add-to-cart]');
      var addLabel = form.querySelector('[data-add-to-cart-label]');

      function formatMoney(cents) {
        return '$' + (cents / 100).toFixed(2);
      }

      function currentSelection() {
        var values = [];
        form.querySelectorAll('[data-option-index]:checked').forEach(function (input) {
          values[parseInt(input.dataset.optionIndex, 10)] = input.value;
        });
        return values;
      }

      function findVariant(values) {
        return productVariants.filter(function (v) {
          return values.every(function (val, i) { return v.options[i] === val; });
        })[0];
      }

      function updateUI() {
        var variant = findVariant(currentSelection());
        if (!variant) {
          if (addBtn) addBtn.disabled = true;
          return;
        }
        if (variantSelect) variantSelect.value = variant.id;
        if (priceEl) priceEl.textContent = formatMoney(variant.price);
        if (addLabel) addLabel.textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';
        if (addBtn) addBtn.disabled = !variant.available;
      }

      form.querySelectorAll('[data-option-index]').forEach(function (input) {
        input.addEventListener('change', updateUI);
      });
    })();
  </script>
{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
