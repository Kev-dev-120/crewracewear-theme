{% doc %}
  @prompt
    Tabs to click and navigate to different sections of site
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tabs-navigation-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-tabs-navigation__tabs-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_spacing }}px;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .ai-tabs-navigation__tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-tabs-navigation__tabs-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.border_color }};
    border-radius: 3px;
  }

  .ai-tabs-navigation__tab-{{ ai_gen_id }} {
    padding: {{ block.settings.tab_padding }}px {{ block.settings.tab_padding | times: 1.5 }}px;
    background: none;
    border: none;
    border-bottom: {{ block.settings.active_border_width }}px solid transparent;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-family: {{ block.settings.tab_font.family }}, {{ block.settings.tab_font.fallback_families }};
    font-weight: {{ block.settings.tab_font.weight }};
    color: {{ block.settings.tab_color }};
    white-space: nowrap;
    transition: all 0.3s ease;
    position: relative;
    margin-bottom: -{{ block.settings.border_width }}px;
  }

  .ai-tabs-navigation__tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_hover_color }};
  }

  .ai-tabs-navigation__tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-tabs-navigation__content-{{ ai_gen_id }} {
    margin-top: {{ block.settings.content_spacing }}px;
  }

  .ai-tabs-navigation__panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tabs-navigation__panel-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tabs-navigation__panel-content-{{ ai_gen_id }} {
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_font_size }}px;
  }

  .ai-tabs-navigation__panel-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-tabs-navigation__panel-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-tabs-navigation__tabs-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_spacing | times: 0.7 }}px;
    }

    .ai-tabs-navigation__tab-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding | times: 0.8 }}px {{ block.settings.tab_padding | times: 1.2 }}px;
    }
  }
{% endstyle %}

<tabs-navigation-{{ ai_gen_id }}
  class="ai-tabs-navigation-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tabs-navigation__tabs-{{ ai_gen_id }}" role="tablist">
    {% for i in (1..5) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
      %}

      {% if tab_enabled and tab_title != blank %}
        <button
          class="ai-tabs-navigation__tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="ai-tabs-navigation-panel-{{ ai_gen_id }}-{{ i }}"
          id="ai-tabs-navigation-tab-{{ ai_gen_id }}-{{ i }}"
          data-tab-index="{{ i }}"
        >
          {{ tab_title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-tabs-navigation__content-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_content_key = 'tab_' | append: i | append: '_content'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
        assign tab_content = block.settings[tab_content_key]
      %}

      {% if tab_enabled and tab_title != blank %}
        <div
          class="ai-tabs-navigation__panel-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          role="tabpanel"
          aria-labelledby="ai-tabs-navigation-tab-{{ ai_gen_id }}-{{ i }}"
          id="ai-tabs-navigation-panel-{{ ai_gen_id }}-{{ i }}"
          tabindex="0"
        >
          <div class="ai-tabs-navigation__panel-content-{{ ai_gen_id }}">
            {% if tab_content != blank %}
              {{ tab_content }}
            {% else %}
              <p style="color: #999; font-style: italic;">Add content for {{ tab_title }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</tabs-navigation-{{ ai_gen_id }}>

<script>
  (function() {
    class TabsNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tabs-navigation__tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-tabs-navigation__panel-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            this.switchTab(tab);
          });

          tab.addEventListener('keydown', (e) => {
            this.handleKeyboard(e, tab);
          });
        });
      }

      switchTab(selectedTab) {
        const tabIndex = selectedTab.getAttribute('data-tab-index');

        this.tabs.forEach((tab) => {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        });

        this.panels.forEach((panel) => {
          panel.classList.remove('active');
        });

        selectedTab.classList.add('active');
        selectedTab.setAttribute('aria-selected', 'true');

        const selectedPanel = this.querySelector('#ai-tabs-navigation-panel-{{ ai_gen_id }}-' + tabIndex);
        if (selectedPanel) {
          selectedPanel.classList.add('active');
        }
      }

      handleKeyboard(e, currentTab) {
        const tabsArray = Array.from(this.tabs);
        const currentIndex = tabsArray.indexOf(currentTab);

        let nextTab;

        if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextTab = tabsArray[currentIndex + 1] || tabsArray[0];
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          nextTab = tabsArray[currentIndex - 1] || tabsArray[tabsArray.length - 1];
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextTab = tabsArray[0];
        } else if (e.key === 'End') {
          e.preventDefault();
          nextTab = tabsArray[tabsArray.length - 1];
        }

        if (nextTab) {
          nextTab.focus();
          this.switchTab(nextTab);
        }
      }
    }

    customElements.define('tabs-navigation-{{ ai_gen_id }}', TabsNavigation{{ ai_gen_id }});
  })();
</script>

