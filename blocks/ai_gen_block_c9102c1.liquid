{% doc %}
  @prompt
    Create a custom CSS code block for a racewear apparel product page that does the following: 1. Adds styled left/right navigation arrows to the product image gallery for dynamic image browsing - bold, modern arrows that match a performance/sporty aesthetic 2. Cleans up the product information section layout for a cleaner, more premium look - reduce visual clutter, improve spacing, bold modern feel 3. IMPORTANT: Do NOT hide, disable, or affect variant option availability in any way. All size and color variant buttons must remain fully visible, clickable, and show correct in-stock/out-of-stock states. Only style them to look cleaner - do not use display:none or visibility:hidden or pointer-events:none on any variant selectors or option buttons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-page-styles-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-gallery-nav-{{ ai_gen_id }} .product__media-list {
    position: relative;
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background-color: {{ block.settings.arrow_background }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.arrow_border_radius }}px;
    opacity: {{ block.settings.arrow_opacity }};
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    border-color: {{ block.settings.arrow_hover_border_color }};
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }}--left {
    left: {{ block.settings.arrow_offset }}px;
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }}--right {
    right: {{ block.settings.arrow_offset }}px;
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
    stroke: {{ block.settings.arrow_color }};
    stroke-width: {{ block.settings.arrow_stroke_width }};
  }

  .ai-product-gallery-arrow-{{ ai_gen_id }}:hover svg {
    stroke: {{ block.settings.arrow_hover_color }};
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product__info-wrapper {
    padding: {{ block.settings.info_padding }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product__title {
    margin-bottom: {{ block.settings.title_spacing }}px;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .price {
    margin-bottom: {{ block.settings.price_spacing }}px;
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product-form {
    margin-top: {{ block.settings.form_spacing }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product-form__input {
    margin-bottom: {{ block.settings.input_spacing }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} fieldset.product-form__input {
    padding: {{ block.settings.variant_section_padding }}px;
    border: {{ block.settings.variant_section_border_width }}px solid {{ block.settings.variant_section_border_color }};
    border-radius: {{ block.settings.variant_section_border_radius }}px;
    background-color: {{ block.settings.variant_section_background }};
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product-form__input legend {
    font-weight: {{ block.settings.variant_label_weight }};
    margin-bottom: {{ block.settings.variant_label_spacing }}px;
    text-transform: {{ block.settings.variant_label_transform }};
    letter-spacing: {{ block.settings.variant_label_letter_spacing }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product-form__input input[type="radio"] + label {
    padding: {{ block.settings.variant_button_padding }}px;
    border-width: {{ block.settings.variant_button_border_width }}px;
    border-radius: {{ block.settings.variant_button_border_radius }}px;
    font-weight: {{ block.settings.variant_button_weight }};
    transition: all 0.2s ease;
    margin: {{ block.settings.variant_button_margin }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product-form__input input[type="radio"]:checked + label {
    border-width: {{ block.settings.variant_button_active_border_width }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product__description {
    margin-top: {{ block.settings.description_spacing }}px;
    line-height: {{ block.settings.description_line_height }};
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .product__accordion {
    margin-top: {{ block.settings.accordion_spacing }}px;
  }

  .ai-product-info-cleanup-{{ ai_gen_id }} .accordion__title {
    font-weight: {{ block.settings.accordion_title_weight }};
    padding: {{ block.settings.accordion_padding }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-gallery-arrow-{{ ai_gen_id }} {
      width: calc({{ block.settings.arrow_size }}px * 0.8);
      height: calc({{ block.settings.arrow_size }}px * 0.8);
    }

    .ai-product-gallery-arrow-{{ ai_gen_id }}--left {
      left: calc({{ block.settings.arrow_offset }}px * 0.5);
    }

    .ai-product-gallery-arrow-{{ ai_gen_id }}--right {
      right: calc({{ block.settings.arrow_offset }}px * 0.5);
    }

    .ai-product-info-cleanup-{{ ai_gen_id }} .product__info-wrapper {
      padding: calc({{ block.settings.info_padding }}px * 0.7);
    }
  }
{% endstyle %}

<product-page-enhancer-{{ ai_gen_id }} class="ai-product-page-styles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
</product-page-enhancer-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductPageEnhancer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.galleryInitialized = false;
        this.currentImageIndex = 0;
      }

      connectedCallback() {
        this.addGalleryClasses();
        this.addInfoClasses();
        this.initializeGalleryNavigation();
      }

      addGalleryClasses() {
        const mediaList = document.querySelector('.product__media-list');
        if (mediaList) {
          mediaList.classList.add('ai-product-gallery-nav-{{ ai_gen_id }}');
        }
      }

      addInfoClasses() {
        const productInfo = document.querySelector('.product__info-container');
        if (productInfo) {
          productInfo.classList.add('ai-product-info-cleanup-{{ ai_gen_id }}');
        }
      }

      initializeGalleryNavigation() {
        const mediaList = document.querySelector('.product__media-list');
        if (!mediaList || this.galleryInitialized) return;

        const mediaItems = mediaList.querySelectorAll('.product__media-item');
        if (mediaItems.length <= 1) return;

        const leftArrow = document.createElement('button');
        leftArrow.className = 'ai-product-gallery-arrow-{{ ai_gen_id }} ai-product-gallery-arrow-{{ ai_gen_id }}--left';
        leftArrow.setAttribute('aria-label', 'Previous image');
        leftArrow.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        `;

        const rightArrow = document.createElement('button');
        rightArrow.className = 'ai-product-gallery-arrow-{{ ai_gen_id }} ai-product-gallery-arrow-{{ ai_gen_id }}--right';
        rightArrow.setAttribute('aria-label', 'Next image');
        rightArrow.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        `;

        mediaList.appendChild(leftArrow);
        mediaList.appendChild(rightArrow);

        leftArrow.addEventListener('click', () => this.navigateGallery(-1, mediaItems));
        rightArrow.addEventListener('click', () => this.navigateGallery(1, mediaItems));

        this.galleryInitialized = true;
      }

      navigateGallery(direction, mediaItems) {
        this.currentImageIndex = (this.currentImageIndex + direction + mediaItems.length) % mediaItems.length;
        
        const thumbnails = document.querySelectorAll('.product__media-toggle');
        if (thumbnails[this.currentImageIndex]) {
          thumbnails[this.currentImageIndex].click();
        }
      }
    }

    customElements.define('product-page-enhancer-{{ ai_gen_id }}', ProductPageEnhancer{{ ai_gen_id }});
  })();
</script>

